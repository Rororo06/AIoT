{
  "version": 1,
  "author": "AIoT course project",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-mpu6050",
      "id": "imu1",
      "top": -80,
      "left": 250,
      "attrs": {
        "accelX": "0",
        "accelY": "-0.98",
        "accelZ": "0.1",
        "rotationX": "0",
        "rotationY": "0",
        "rotationZ": "0",
        "temperature": "24"
      }
    },
    { "type": "wokwi-led", "id": "led_sit", "top": 130, "left": 250, "attrs": { "color": "blue", "label": "SIT" } },
    { "type": "wokwi-led", "id": "led_walk", "top": 130, "left": 320, "attrs": { "color": "green", "label": "WALK" } },
    { "type": "wokwi-led", "id": "led_fall", "top": 130, "left": 390, "attrs": { "color": "red", "label": "FALL" } },
    { "type": "wokwi-resistor", "id": "r_sit", "top": 220, "left": 250, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_walk", "top": 220, "left": 320, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_fall", "top": 220, "left": 390, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

