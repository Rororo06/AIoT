    [ "imu1:SCL", "esp:22", "blue", [ "v0" ] ],

    [ "esp:25", "led_sit:A", "blue", [ "v0" ] ],
    [ "led_sit:C", "r_sit:1", "black", [ "v0" ] ],
    [ "r_sit:2", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:26", "led_walk:A", "green", [ "v0" ] ],
    [ "led_walk:C", "r_walk:1", "black", [ "v0" ] ],
    [ "r_walk:2", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:27", "led_fall:A", "red", [ "v0" ] ],
    [ "led_fall:C", "r_fall:1", "black", [ "v0" ] ],
    [ "r_fall:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
